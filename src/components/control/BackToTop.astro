---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<!-- 右下角的「回到顶部」：与站点风格一致（btn-card + 主色图标），距离视口边缘留有间距、不贴边 -->
<div class="back-to-top-wrapper">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center rounded-2xl overflow-hidden transition" onclick="backToTop()">
        <button aria-label="Back to Top" class="btn-card h-12 w-12 shadow-lg dark:shadow-xl dark:shadow-black/45 lg:h-[3.75rem] lg:w-[3.75rem]">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 0
    height: 0
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    /* 固定在视口右下角，右/下各留 1.5rem，桌面 2rem —— 不贴边 */
    position: fixed
    right: 1.5rem
    bottom: 1.5rem
    z-index: 40
    opacity: 1
    cursor: pointer
    pointer-events: auto
    i
        font-size: 1.75rem
    &.hide
        transform: translateY(0.75rem) scale(0.9)
        opacity: 0
        pointer-events: none
    &:active
      transform: scale(0.9)

@media (min-width: 1024px)
    .back-to-top-btn
        right: 2rem
        bottom: 2rem
        i
            font-size: 2rem
</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>
