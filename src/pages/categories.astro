---
import ButtonLink from "@components/control/ButtonLink.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCategoryList } from "@utils/content-utils";

// 分类总览页（侧栏统计里的「分类」数字跳到这里）
// getCategoryList() 返回的 url 已经指向归档页过滤视图：/archive/?category=xxx
const categories = await getCategoryList();
const total = categories.reduce((sum, c) => sum + c.count, 0);
---

<MainGridLayout title={i18n(I18nKey.categories)} description={i18n(I18nKey.categories)}>
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative min-h-32">
        <div class="card-base z-10 px-9 py-6 relative w-full">
            <div class="font-bold text-2xl transition text-neutral-900 dark:text-neutral-100 relative ml-4 mb-4
                before:w-1 before:h-5 before:rounded-md before:bg-[var(--primary)]
                before:absolute before:-left-4 before:top-[0.4rem]"
            >
                {i18n(I18nKey.categories)}
                <span class="text-sm font-normal text-black/30 dark:text-white/30 ml-2">{categories.length} / {total}</span>
            </div>

            {categories.length > 0 ? (
                <div class="transition flex flex-col">
                    {categories.map((c) => (
                        <ButtonLink
                            url={c.url}
                            badge={String(c.count)}
                            label={`View all posts in the ${c.name.trim()} category`}
                        >
                            {c.name.trim()}
                        </ButtonLink>
                    ))}
                </div>
            ) : (
                <div class="transition text-black/40 dark:text-white/40">{i18n(I18nKey.uncategorized)}</div>
            )}
        </div>
    </div>
</MainGridLayout>
